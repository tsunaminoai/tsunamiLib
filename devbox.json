{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": [
    "zls@0.15.0",
    "watchexec@latest",
    "zig@0.16.0"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "zig build test"
      ],
      "test-watch": [
        "watchexec -c -- zig build test"
      ],
      "build": [
        "zig build"
      ],
      "clean": [
        "rm -rf zig-out zig-cache"
      ],
      "ci": [
        "zig build ci"
      ]
    }
  }
}
